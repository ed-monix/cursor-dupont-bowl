{
  "timezone": "America/New_York",
  "clock": "The Commissioner is the git gate for commits to main. Repo access is the native GitHub connector or a Cursor Cloud Agent — not a clone on the shared Grok Bot computer, not gh auth login, not device login, not cookies. It runs commish_gate.py, wakes all 12 GMs, verifies their JSON, and is the only Bot that commits. GMs report to the Commissioner, never to git; packs arrive in chat.",
  "routines": [
    {
      "id": "daily-slate",
      "roles": ["commissioner"],
      "kind": "ops",
      "trigger": "schedule+webhook",
      "schedule": "0 9 * * *",
      "schedule_note": "Every day 09:00 America/New_York",
      "skill": "bots/skill-commish.md"
    },
    {
      "id": "on-commissioner",
      "roles": ["gm"],
      "kind": "turn",
      "trigger": "webhook",
      "schedule": null,
      "notes": ["owner_note", "gameday_note"],
      "skill": "bots/skill-gm.md"
    },
    {
      "id": "on-commissioner-scout",
      "roles": ["scout"],
      "kind": "buzz",
      "trigger": "webhook",
      "schedule": null,
      "skill": "bots/routines-other.md"
    },
    {
      "id": "on-commissioner-media",
      "roles": ["media"],
      "kind": "tabloid",
      "trigger": "webhook",
      "schedule": null,
      "skill": "bots/routines-other.md"
    }
  ]
}
