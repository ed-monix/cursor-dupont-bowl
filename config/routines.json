    },
    {
      "id": "on-commissioner-scout",
      "roles": ["scout"],
      "kind": "buzz",
      "trigger": "webhook",
      "schedule": null,
      "skill": "bots/routines-other.md"
    },
    {
      "id": "on-commissioner-media",
      "roles": ["media"],
